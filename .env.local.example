# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Model / OpenRouter ───────────────────────────────────────────────────────
# Never put a provider key in a VITE_* variable; Vite embeds it in public JS.
# Configure OPENROUTER_API_KEY only in the trusted server/Edge Function secret store.

# Agent model override (optional). Defaults to the fast nvidia/nemotron-3.5-lightning:free.
# Pin a faster free model for speed, e.g.:
# VITE_AGENT_MODEL=nvidia/nemotron-3.5-lightning:free
# The model name is public configuration. Leave it unset for the app default.

# ── DeepSeek Harness engine (local Node service) ─────────────────────────────
# Empty = same origin. In `npm run dev` Vite proxies /api to 127.0.0.1:8787.
# Set this only when the engine runs on another host/port.
# VITE_HARNESS_API_URL=

# Used by the Vite dev proxy, not by the browser bundle.
# VITE_HARNESS_DEV_URL=http://127.0.0.1:8787

# Server-side (npm run server / Electron main), not Vite:
# DSH_BIN=/Applications/DeepSeek Harness.app/Contents/Resources/runtime/cli/bin/dsh
# DSH_HOME=~/.dsh
# FLUTTERFORGE_DSH_PROFILE=flutterforge-engine
# FLUTTERFORGE_WORKSPACES=~/.flutterforge/workspaces
# OPENROUTER_API_KEY=...         (server process environment only)

# ── Preview ──────────────────────────────────────────────────────────────────
# Empty = same-origin. The Node bridge compiles Flutter web locally.
# Set only when using the optional Docker preview farm in preview-infra/.
# VITE_PREVIEW_API_URL=http://localhost:3001
# Or Cloudflare Tunnel public URL (trycloudflare.com free no card):
# VITE_PREVIEW_API_URL=https://xxxx-xxxx.trycloudflare.com

# ── React Bits Pro (private shadcn registry) ─────────────────────────────────
# Required only to install paid React Bits Pro blocks with `npx shadcn add`.
# Get it from https://pro.reactbits.dev after purchase. Never commit the real key.
REACTBITS_LICENSE_KEY=your-license-key-here
